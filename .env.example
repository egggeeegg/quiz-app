# Server
PORT=3001

# 必填：至少 24 位随机字符串，缺失或使用示例值会导致后端拒绝启动
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Database
DATABASE_PATH=./data/quiz.db

# Frontend URL (for CORS in dev)
FRONTEND_URL=http://localhost:5173

# 首次启动且用户表为空时创建的管理员账号
# 不填 ADMIN_PASSWORD 会随机生成密码并打印到后端启动日志
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
